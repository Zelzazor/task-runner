{
	"version": "2.0.0",
	"tasks": [
		{
			"label": "Build App",
			"type": "shell",
			"command": "echo build",
			"group": {
				"kind": "build",
				"isDefault": true
			}
		},
		{
			"label": "Run Tests",
			"type": "shell",
			"command": "echo test",
			"group": "test"
		},
		{
			"label": "Deploy",
			"type": "shell",
			"command": "echo deploy",
			"options": {
				"task-runner.group": "Deploy"
			}
		}
	]
}
