{
  "name": "task-runner",
  "displayName": "task-runner",
  "description": "A tab added to VSCode that allows you to easily run tasks from your tasks.json without having to use the command palette. ",
  "version": "0.0.1",
  "engines": {
    "vscode": "^1.137.0"
  },
  "categories": [
    "Other"
  ],
  "activationEvents": [],
  "main": "./dist/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "task-runner.refresh",
        "title": "Refresh Tasks",
        "icon": "$(refresh)",
        "category": "Task Runner"
      },
      {
        "command": "task-runner.runTask",
        "title": "Run Task",
        "category": "Task Runner"
      },
      {
        "command": "task-runner.openTasksJson",
        "title": "Open tasks.json",
        "icon": "$(go-to-file)",
        "category": "Task Runner"
      },
      {
        "command": "task-runner.revealTaskInJson",
        "title": "Reveal in tasks.json",
        "category": "Task Runner"
      }
    ],
    "menus": {
      "view/title": [
        {
          "command": "task-runner.refresh",
          "when": "view == taskRunner.tasksView",
          "group": "navigation"
        },
        {
          "command": "task-runner.openTasksJson",
          "when": "view == taskRunner.tasksView",
          "group": "navigation"
        }
      ],
      "view/item/context": [
        {
          "command": "task-runner.runTask",
          "when": "view == taskRunner.tasksView && viewItem =~ /^task-/",
          "group": "inline"
        },
        {
          "command": "task-runner.revealTaskInJson",
          "when": "view == taskRunner.tasksView && viewItem =~ /^task-/"
        },
        {
          "command": "task-runner.openTasksJson",
          "when": "view == taskRunner.tasksView && viewItem == 'folder'"
        }
      ]
    },
    "viewsContainers": {
      "activitybar": [
        {
          "id": "taskRunner",
          "title": "Task Runner",
          "icon": "resources/activity-bar-icon.svg"
        }
      ]
    },
    "views": {
      "taskRunner": [
        {
          "id": "taskRunner.tasksView",
          "name": "Tasks"
        }
      ]
    },
    "viewsWelcome": [
      {
        "view": "taskRunner.tasksView",
        "contents": "No tasks found in tasks.json.\n[Configure a Task](command:workbench.action.tasks.configureTaskRunner)",
        "when": "!taskRunner.hasTasks"
      }
    ]
  },
  "scripts": {
    "vscode:prepublish": "npm run package",
    "compile": "npm run check-types && npm run lint && node esbuild.js",
    "watch": "npm-run-all -p watch:*",
    "watch:esbuild": "node esbuild.js --watch",
    "watch:tsc": "tsc --noEmit --watch --project tsconfig.json",
    "package": "npm run check-types && npm run lint && node esbuild.js --production",
    "compile-tests": "tsc -p . --outDir out",
    "watch-tests": "tsc -p . -w --outDir out",
    "pretest": "npm run compile-tests && npm run compile && npm run lint",
    "check-types": "tsc --noEmit",
    "lint": "eslint src",
    "test": "vscode-test"
  },
  "devDependencies": {
    "@types/vscode": "^1.137.0",
    "@types/mocha": "^10.0.10",
    "@types/node": "24.x",
    "typescript-eslint": "^8.61.1",
    "eslint": "^10.5.0",
    "esbuild": "^0.28.1",
    "npm-run-all": "^4.1.5",
    "typescript": "^6.0.3",
    "@vscode/test-cli": "^0.0.15",
    "@vscode/test-electron": "^3.0.0"
  },
  "overrides": {
    "diff": "^8.0.4",
    "serialize-javascript": "^7.0.6"
  }
}
